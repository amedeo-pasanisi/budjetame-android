<?xml version="1.0" encoding="utf-8"?>
<!-- The 💸 glyph rendered from Noto Color Emoji (the font Android itself
     uses), composited on the brand indigo background. Density buckets live
     in mipmap-{m,h,x,xx,xxx}dpi/ic_launcher_foreground.png: the glyph's ink
     is sized so its extremes stay inside the adaptive-icon safe zone (the
     66dp circle), keeping the wingtips unclipped under every launcher
     mask. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
